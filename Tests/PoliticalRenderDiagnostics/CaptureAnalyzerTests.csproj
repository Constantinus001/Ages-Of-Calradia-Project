<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <OutputType>Exe</OutputType><AssemblyName>CaptureAnalyzerTests</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <OutputPath>bin\CaptureAnalyzer\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\CaptureAnalyzer\$(Configuration)\</IntermediateOutputPath>
    <Optimize>true</Optimize><Deterministic>true</Deterministic>
    <WarningLevel>4</WarningLevel><TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup><Reference Include="System" /><Reference Include="System.Core" /></ItemGroup>
  <ItemGroup><Compile Include="CaptureAnalyzer.cs" /><Compile Include="CaptureAnalyzerTests.cs" /></ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
