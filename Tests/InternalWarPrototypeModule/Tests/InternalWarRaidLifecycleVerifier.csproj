<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <OutputType>Exe</OutputType>
    <AssemblyName>InternalWarRaidLifecycleVerifier</AssemblyName>
    <TargetFrameworkVersion>v4.7.2</TargetFrameworkVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\RaidLifecycle\$(Configuration)\</IntermediateOutputPath>
    <Deterministic>true</Deterministic>
    <WarningLevel>4</WarningLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Compile Include="RaidLifecycleProgram.cs" />
    <Compile Include="RaidLifecycleStubs.cs" />
    <Compile Include="..\InternalWarTestRaids.cs" />
    <Compile Include="..\InternalWarNpcRaids.cs" />
    <Compile Include="..\InternalWarRaidRecord.cs" />
    <Compile Include="..\InternalConflictRecord.cs" />
    <Compile Include="..\InternalWarTestRecord.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
